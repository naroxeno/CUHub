<Project>

  <PropertyGroup>
    <CuhubGameDir Condition="'$(CuhubGameDir)' == '' and '$(CUHUB_GAME_DIR)' != ''">$(CUHUB_GAME_DIR)</CuhubGameDir>
    <CuhubGameDir Condition="'$(CuhubGameDir)' == '' and '$(HOME)' != ''">$(HOME)/.steam/steam/steamapps/common/Casualties Unknown</CuhubGameDir>
  </PropertyGroup>

  <Target Name="RequireCuhubGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(CuhubGameDir)' == ''">
    <Error Text="CuhubGameDir is empty. Set CUHUB_GAME_DIR or pass -p:CuhubGameDir=&lt;game dir&gt;." />
  </Target>

</Project>
